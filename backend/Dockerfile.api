# syntax=docker/dockerfile:1
# Build context = repo root (see docker-compose api service).

# ── frontend bundles ────────────────────────────────────────────────────
FROM node:24-slim AS frontend
WORKDIR /fe

# miniapp — cache deps first (layer stays valid across code-only commits)
COPY frontend/miniapp/package*.json frontend/miniapp/
RUN cd frontend/miniapp && npm ci
COPY frontend/miniapp frontend/miniapp
RUN cd frontend/miniapp && npm run build

# admin — same pattern: package.json → npm ci → rest of code
COPY frontend/admin/package*.json frontend/admin/
RUN cd frontend/admin && npm ci
COPY frontend/admin frontend/admin
RUN cd frontend/admin && npm run build

# ── backend ─────────────────────────────────────────────────────────────
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.5.20 /uv /usr/local/bin/uv

# Install dependencies from lockfile first (layer cached across code commits)
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev

# Application code (scripts/ is NOT part of the app wheel — copy it explicitly)
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY backend/scripts ./scripts
COPY backend/start.sh ./start.sh

# Frontend bundles
COPY --from=frontend /fe/frontend/miniapp/dist /static/miniapp
COPY --from=frontend /fe/frontend/admin/dist /static/admin

RUN useradd -r -u 10001 appuser && chown -R appuser /app /static
USER appuser
EXPOSE 8000
CMD ["sh", "start.sh"]