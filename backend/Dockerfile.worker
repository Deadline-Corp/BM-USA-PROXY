# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.5.20 /uv /usr/local/bin/uv

# Install dependencies from lockfile first (layer cached across code commits)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Application code (scripts/ is NOT part of the app wheel — copy it explicitly)
COPY app ./app
COPY scripts ./scripts

RUN useradd -r -u 10001 appuser && chown -R appuser /app
USER appuser

CMD ["arq", "app.workers.main.WorkerSettings"]